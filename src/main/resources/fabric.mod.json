{
  "schemaVersion": 1,
  "id": "fsit",
  "version": "${version}",
  "name": "FSit",
  "description": "Sit anywhere! Unofficial Minecraft 26.3 build by imaron85, not made or supported by rvbsm. Report problems at https://github.com/imaron85/fsit/issues.",
  "authors": [
    "rvbsm"
  ],
  "contact": {
    "homepage": "https://github.com/imaron85/fsit",
    "sources": "https://github.com/imaron85/fsit",
    "issues": "https://github.com/imaron85/fsit/issues"
  },
  "license": "MIT",
  "icon": "assets/fsit/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.rvbsm.fsit.FSitMod"],
    "client": ["dev.rvbsm.fsit.client.FSitModClient"],
    "modmenu": ["dev.rvbsm.fsit.client.compat.modmenu.ModMenuApi"]
  },
  "mixins": [
    "fsit.mixins.json",
    {
      "config": "fsit.client.mixins.json",
      "environment": "client"
    }
  ],
  "accessWidener": "fsit.classtweaker",
  "depends": {
    "java": "${java}",
    "minecraft": "${minecraft}",
    "fabricloader": ">=0.18.0",
    "fabric-api-base": "*",
    "fabric-command-api-v2": "*",
    "fabric-lifecycle-events-v1": "*",
    "fabric-networking-api-v1": "*"
  },
  "suggests": {
    "fabric-permissions-api-v1": "*",
    "modmenu": "*",
    "yet_another_config_lib_v3": ">=3.9.0"
  }
}
